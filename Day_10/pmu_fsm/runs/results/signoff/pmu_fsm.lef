    USE SIGNAL ;
    ANTENNAGATEAREA 0.196500 ;
    PORT
      LAYER met2 ;
        RECT 61.730 0.000 62.010 4.000 ;
    END
  END wake_up
  OBS
      LAYER nwell ;
        RECT 5.330 10.795 65.970 70.805 ;
      LAYER li1 ;
        RECT 5.520 10.795 65.780 70.805 ;
      LAYER met1 ;
        RECT 4.210 10.240 65.780 70.960 ;
      LAYER met2 ;
        RECT 4.230 77.855 17.290 78.135 ;
        RECT 18.130 77.855 52.710 78.135 ;
        RECT 53.550 77.855 64.310 78.135 ;
        RECT 4.230 4.280 64.310 77.855 ;
        RECT 4.230 2.875 9.010 4.280 ;
        RECT 9.850 2.875 26.490 4.280 ;
        RECT 27.330 2.875 43.970 4.280 ;
        RECT 44.810 2.875 61.450 4.280 ;
        RECT 62.290 2.875 64.310 4.280 ;
      LAYER met3 ;
        RECT 4.400 77.160 67.415 78.025 ;
        RECT 3.990 71.760 67.415 77.160 ;
        RECT 4.400 70.360 67.415 71.760 ;
        RECT 3.990 69.040 67.415 70.360 ;
        RECT 3.990 67.640 67.015 69.040 ;
        RECT 3.990 64.960 67.415 67.640 ;
        RECT 4.400 63.560 67.415 64.960 ;
        RECT 3.990 58.160 67.415 63.560 ;
        RECT 4.400 56.760 67.415 58.160 ;
        RECT 3.990 51.360 67.415 56.760 ;
        RECT 4.400 49.960 67.415 51.360 ;
        RECT 3.990 44.560 67.415 49.960 ;
        RECT 4.400 43.160 67.415 44.560 ;
        RECT 3.990 41.840 67.415 43.160 ;
        RECT 3.990 40.440 67.015 41.840 ;
        RECT 3.990 37.760 67.415 40.440 ;
        RECT 4.400 36.360 67.415 37.760 ;
        RECT 3.990 30.960 67.415 36.360 ;
        RECT 4.400 29.560 67.415 30.960 ;
        RECT 3.990 24.160 67.415 29.560 ;
        RECT 4.400 22.760 67.415 24.160 ;
        RECT 3.990 17.360 67.415 22.760 ;
        RECT 4.400 15.960 67.415 17.360 ;
        RECT 3.990 14.640 67.415 15.960 ;
        RECT 3.990 13.240 67.015 14.640 ;
        RECT 3.990 10.560 67.415 13.240 ;
        RECT 4.400 9.160 67.415 10.560 ;
        RECT 3.990 3.760 67.415 9.160 ;
        RECT 4.400 2.895 67.415 3.760 ;
      LAYER met4 ;
        RECT 24.215 30.775 24.640 55.585 ;
        RECT 28.440 30.775 29.145 55.585 ;
  END
END pmu_fsm
END LIBRARY

